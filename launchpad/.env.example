# Copy this file to the repository root as .env.launchpad, then replace the
# placeholder values before starting Docker Compose.

# Required: NGC personal API key with access to NIM containers and model assets.
NGC_API_KEY=<paste-ngc-api-key>

# The app clients use local NIM base URLs below. This value is still expected by
# the blueprint environment, but it is not used for hosted inference here.
NVIDIA_API_KEY=local-nim

# Use an absolute host path with enough space for NIM model assets.
MODEL_DIRECTORY=/home/nvidia/.cache/nim

# Match the LaunchPad Linux user that will write to MODEL_DIRECTORY.
USERID=1000:1000

# Used by the base Compose file's pgAdmin user interpolation.
UID=1000
GID=1000

# Prebuilt application images. These were built for the CPU Milvus compose path,
# but the app images are runtime-configured and can still talk to GPU Milvus.
# Omit deploy/compose/docker-compose.ghcr.yaml if you want to build from the
# local Dockerfiles instead.
GHCR_OWNER=jspaulding-nv
GHCR_IMAGE_PREFIX=aiva-customer-service
GHCR_TAG=nemotron3-milvus-cpu
LAUNCHPAD_UI_TAG=nemotron3-launchpad-proxy

# Local NIM endpoints used by the blueprint services.
APP_LLM_MODELNAME=nvidia/nemotron-3-nano-30b-a3b
APP_LLM_SERVERURL=nemollm-inference:8000
APP_EMBEDDINGS_MODELNAME=nvidia/llama-nemotron-embed-1b-v2
APP_EMBEDDINGS_SERVERURL=nemollm-embedding:8000
APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-1b-v2
APP_RANKING_SERVERURL=ranking-ms:8000

# Two-H100 LaunchPad GPU layout.
LLM_MS_GPU_ID=0
EMBEDDING_MS_GPU_ID=1
RANKING_MS_GPU_ID=1
MILVUS_GPU_ID=1

# NIM and Milvus versions.
NEMOTRON3_NANO_NIM_TAG=2.0.5
EMBEDDING_NIM_TAG=1.13.0
RANKING_NIM_TAG=1.10.0
MILVUS_GPU_TAG=v2.4.15-gpu

# Required by Nemotron 3 Nano reasoning output and the agent's LangGraph tool calls.
NIM_PASSTHROUGH_ARGS=--reasoning-parser nemotron_v3 --enable-auto-tool-choice --tool-call-parser qwen3_coder

# New Milvus collections should use a GPU index for this LaunchPad path.
APP_VECTORSTORE_INDEXTYPE=GPU_IVF_FLAT
APP_VECTORSTORE_NLIST=64
APP_VECTORSTORE_NPROBE=16
KNOWHERE_GPU_MEM_POOL_SIZE="2048;4096"

DOCKER_VOLUME_DIRECTORY=.
PGADMIN_PORT=5050
LOGLEVEL=INFO

# Local Nemotron 3 Nano can take longer than hosted NIMs for the full agent graph,
# especially on the first request after startup.
GRAPH_TIMEOUT_IN_SEC=120

# Product-manual QA should consider more chunks than order/return workflows.
APP_PRODUCT_QA_TOP_K=8
